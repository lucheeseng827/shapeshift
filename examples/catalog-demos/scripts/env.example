# env.example — env for the shapeshift catalog demos against the local docker stack.
#   cp scripts/env.example scripts/.env && source scripts/.env

# ── Object store (MinIO, S3-compatible) — where shapeshift lands Iceberg tables ──────
export AWS_ACCESS_KEY_ID=minio
export AWS_SECRET_ACCESS_KEY=minio123
export AWS_REGION=us-east-1
export AWS_ENDPOINT=http://localhost:9000        # shapeshift-objstore reads AWS_ENDPOINT
export AWS_ALLOW_HTTP=true                        # MinIO is plain HTTP locally
export S3_ENDPOINT=http://localhost:9000          # register_catalog.py → s3.endpoint

# ── Streaming (Redpanda / Kafka) ────────────────────────────────────────────────────
export BROKER=localhost:9092

# ── Database (Postgres) ─────────────────────────────────────────────────────────────
export PGHOST=localhost
export PGPORT=5432
export PGUSER=postgres
export PGPASSWORD=postgres
export PGDATABASE=warehouse

# ── Catalog (Nessie REST) ───────────────────────────────────────────────────────────
export CATALOG_TYPE=rest
export CATALOG_URI=http://localhost:19120/iceberg/
export CATALOG_WAREHOUSE=warehouse

# ── shapeshift binary (built with --features object_store for s3:// output) ──────────
# Resolved relative to this file (scripts/ → crate root is three levels up), so it is
# correct whether the crate lives at the repo root (OSS mirror) or in a monorepo subdir.
export SHAPESHIFT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../../.." && pwd)/target/release/shapeshift"
